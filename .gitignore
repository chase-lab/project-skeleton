# Curated .gitignore. Each section says why it exists.
# Check why a file is ignored with: git check-ignore -v <file>

# --- OS files (macOS, Windows) ---------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*.icloud
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- R session files --------------------------------------------------------
.Rproj.user
.Rhistory
.RData
.Ruserdata

# --- renv -------------------------------------------------------------------
# renv ignores its own internals (renv/library, renv/local, ...) through
# renv/.gitignore once renv::init() has run. Do NOT add renv/ here:
# renv.lock and renv/activate.R MUST be tracked.

# --- Rendered and temporary files -------------------------------------------
*_cache/
*_files/
*.knit.md
*.utf8.md
.quarto/
*.log
README.html
*.tmp

# --- Data -------------------------------------------------------------------
# Raw and processed data stay out of git (size, licences, reproducibility:
# processed data is regenerated by scripts/). Only the folder READMEs are kept.
# Small reference tables you want to share: add them with a "!" negation here,
# e.g. !data/raw/site_coordinates.csv
data/raw/**
!data/raw/README.md
data/processed/**
!data/processed/README.md

# --- Outputs ----------------------------------------------------------------
# Figures and tables are regenerated by scripts/. Ignored by default.
outputs/**
!outputs/README.md

# --- Secrets ----------------------------------------------------------------
.Renviron
*.key
*.pem
